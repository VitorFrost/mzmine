{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/VitorFrost/mzmine/datasets/parity/mzmine_v408_lcms_core_inventory.schema.json",
  "title": "MZmine v4.0.8 LC-MS core parity inventory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "inventory_id",
    "target",
    "fork",
    "classification_policy",
    "modules"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "inventory_id": {"type": "string", "minLength": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "commit", "license", "role", "source_tree", "tag_resolution", "build"],
      "properties": {
        "repository": {"const": "mzmine/mzmine"},
        "tag": {"const": "v4.0.8"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "license": {"const": "MIT"},
        "role": {"const": "behavioral-oracle"},
        "source_tree": {"const": "mzmine-community"},
        "tag_resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["object_type", "resolved_at"],
          "properties": {
            "object_type": {"const": "commit"},
            "resolved_at": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
          }
        },
        "build": {
          "type": "object",
          "additionalProperties": false,
          "required": ["system", "java_version", "enable_preview", "candidate_command", "execution_status", "blockers", "policy"],
          "properties": {
            "system": {"const": "Gradle Wrapper"},
            "java_version": {"const": "21"},
            "enable_preview": {"const": true},
            "candidate_command": {"type": "array", "minItems": 1, "items": {"type": "string"}},
            "execution_status": {"enum": ["blocked-by-independence-policy", "reproducible-public-slice", "complete"]},
            "blockers": {"type": "array", "items": {"type": "string"}},
            "policy": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "fork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "integration_branch", "scientific_base_commit", "application_version"],
      "properties": {
        "repository": {"const": "VitorFrost/mzmine"},
        "integration_branch": {"const": "open-offline-main"},
        "scientific_base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "application_version": {"type": "string", "minLength": 1}
      }
    },
    "classification_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "equivalent_requires_differential_evidence"],
      "properties": {
        "allowed": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 4,
          "maxItems": 4,
          "items": {"enum": ["Equivalent", "Adapted", "Not implemented", "Out of scope"]}
        },
        "equivalent_requires_differential_evidence": {"const": true}
      }
    },
    "modules": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "area", "capability", "classification", "versions", "parameter_mapping", "algorithm_changes", "data_model_changes", "evidence", "differential_gate"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
          "area": {"type": "string", "minLength": 1},
          "capability": {"type": "string", "minLength": 1},
          "classification": {"enum": ["Equivalent", "Adapted", "Not implemented", "Out of scope"]},
          "versions": {
            "type": "object",
            "additionalProperties": false,
            "required": ["base_39", "oracle_408", "open_offline"],
            "properties": {
              "base_39": {"$ref": "#/$defs/source"},
              "oracle_408": {"$ref": "#/$defs/source"},
              "open_offline": {"$ref": "#/$defs/source"}
            }
          },
          "parameter_mapping": {
            "type": "object",
            "additionalProperties": false,
            "required": ["base_version", "oracle_version", "status", "changes"],
            "properties": {
              "base_version": {"type": ["integer", "null"], "minimum": 0},
              "oracle_version": {"type": ["integer", "null"], "minimum": 0},
              "status": {"enum": ["verified", "partial", "pending", "not-applicable"]},
              "changes": {"type": "array", "items": {"type": "string"}}
            }
          },
          "algorithm_changes": {"type": "array", "items": {"type": "string"}},
          "data_model_changes": {"type": "array", "items": {"type": "string"}},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_presence_verified", "direct_differential_complete", "notes"],
            "properties": {
              "source_presence_verified": {"type": "boolean"},
              "direct_differential_complete": {"type": "boolean"},
              "notes": {"type": "array", "items": {"type": "string"}}
            }
          },
          "differential_gate": {
            "type": "object",
            "additionalProperties": false,
            "required": ["dataset_ids", "stages", "exact_fields", "numeric_tolerances", "status"],
            "properties": {
              "dataset_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "stages": {"type": "array", "items": {"type": "string"}, "minItems": 1},
              "exact_fields": {"type": "array", "items": {"type": "string"}},
              "numeric_tolerances": {
                "type": "object",
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["absolute", "relative"],
                  "properties": {
                    "absolute": {"type": "number", "minimum": 0},
                    "relative": {"type": "number", "minimum": 0}
                  }
                }
              },
              "status": {"enum": ["contract-defined", "exporter-pending", "oracle-run-pending", "comparison-pending", "complete"]}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit", "module_path", "parameter_path", "module_blob_sha", "parameter_blob_sha"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "module_path": {"type": "string", "minLength": 1},
        "parameter_path": {"type": ["string", "null"]},
        "module_blob_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "parameter_blob_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
      }
    }
  }
}
